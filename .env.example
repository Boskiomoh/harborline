# Harborline — copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API Keys). The publishable key is safe in the browser;
# never put the secret / service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# AI Assist (docs/AI-ASSIST.md). Only GROQ_API_KEY is required; server-side only.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional daily AI caps (docs/AI-ASSIST.md step G). Without these, AI calls are uncapped.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# AI_DAILY_LIMIT=30            # per visitor (account + IP) per UTC day
# AI_ACCOUNT_DAILY_LIMIT=300   # per account across all IPs
